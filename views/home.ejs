<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Page</title>
</head>
<body>
    <h1>URL Shortener</h1>
    <% if (locals.id) { %>
    <p>URL Generated: http://localhost:8001/url/<%= id %></p>
    <% } %>


    <div>
        <form method="POST" action="/url">
            <label>Enter Your Original URL</label>
            <input type="text" name="url" placeholder="https://example">
            <button type="submit">Generate</button>
        </form>
    </div>

    <table border="1" cellpadding="5" cellspacing="0">
        <thead>
            <tr>
                <th>#</th>
                <th>Short URL</th>
                <th>Original URL</th>
                <th>Clicks</th>
                <th>Short ID</th>
            </tr>
        </thead>
        <tbody>
            <% if (locals.urls && urls.length > 0) { %>
                <% urls.forEach((url, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><a href="/url/<%= url.shortId %>" target="_blank">http://localhost:8001/url/<%= url.shortId %></a></td>
                    <td><%= url.redirectUrl %></td>
                    <td><%= url.clicks || 0 %></td>
                    <td><%= url.shortId %></td>
                </tr>
                <% }); %>
            <% } else { %>
                <tr><td colspan="5" style="text-align: center;">No URLs found</td></tr>
            <% } %>
        </tbody>
    </table>
</body>
</html>